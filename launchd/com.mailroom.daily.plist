<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install substitutes __HOME__ with $HOME (launchd does not expand $HOME). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mailroom.daily</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__HOME__/MailArchive/scripts/run_mailroom_daily.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__HOME__/MailArchive</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
		<key>MAILARCHIVE</key>
		<string>__HOME__/MailArchive</string>
		<key>MAILROOM_KEYCHAIN_ITEM</key>
		<string>mailroom.icloud.app-password</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>20</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>__HOME__/MailArchive/logs/daily_rag.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/MailArchive/logs/daily_rag.stderr.log</string>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
